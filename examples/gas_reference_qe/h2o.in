&CONTROL
  calculation   = 'relax'
  prefix        = 'h2o'
  outdir        = './tmp'
  pseudo_dir    = './pseudo'        !! MATCH THE SLABS
  tprnfor       = .true.
  tstress       = .false.
  forc_conv_thr = 1.0d-4
/
&SYSTEM
  ibrav       = 0
  nat         = 3
  ntyp        = 2
  ecutwfc     = 60.0                !! MATCH THE SLABS (Ry)
  ecutrho     = 480.0               !! MATCH THE SLABS (Ry)
  occupations = 'fixed'             ! closed-shell singlet: no smearing
  nspin       = 1                   !! MATCH THE SLABS if they were spin-polarised
  assume_isolated = 'martyna-tuckerman'
/
&ELECTRONS
  conv_thr     = 1.0d-8
  mixing_beta  = 0.3
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
  O  15.9994   O.paw.pbe.z_6.ld1.psl.v0.1.upf       !! MATCH THE SLABS
  H   1.00794  H.us.pbe.z_1.ld1.psl.v1.0.0-high.upf     !! MATCH THE SLABS

CELL_PARAMETERS angstrom
  15.0   0.0   0.0
   0.0  15.0   0.0
   0.0   0.0  15.0

! O-H 0.958 A, H-O-H 104.5 deg, centred in the box
ATOMIC_POSITIONS angstrom
  O   7.500000   7.500000   7.500000
  H   8.257000   7.500000   8.087000
  H   6.743000   7.500000   8.087000

K_POINTS gamma
