&CONTROL
  calculation   = 'relax'
  prefix        = 'co2'
  outdir        = './tmp'
  pseudo_dir    = './pseudo'        !! MATCH THE SLABS
  tprnfor       = .true.
  tstress       = .false.
  forc_conv_thr = 1.0d-4
/
&SYSTEM
  ibrav       = 0
  nat         = 3
  ntyp        = 2
  ecutwfc     = 60.0                !! MATCH THE SLABS (Ry)
  ecutrho     = 480.0               !! MATCH THE SLABS (Ry)
  occupations = 'fixed'             ! closed-shell singlet: no smearing
  nspin       = 1                   !! MATCH THE SLABS if they were spin-polarised
  assume_isolated = 'martyna-tuckerman'
/
&ELECTRONS
  conv_thr     = 1.0d-8
  mixing_beta  = 0.3
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
  C  12.0107  C.us.pbe.z_4.uspp.gbrv.v1.2.upf     !! MATCH THE SLABS
  O  15.9994  O.paw.pbe.z_6.ld1.psl.v0.1.upf       !! MATCH THE SLABS

CELL_PARAMETERS angstrom
  15.0   0.0   0.0
   0.0  15.0   0.0
   0.0   0.0  15.0

! linear O=C=O, C-O 1.16 A, centred in the box for the Martyna-Tuckerman correction
ATOMIC_POSITIONS angstrom
  C   7.500000   7.500000   7.500000
  O   7.500000   7.500000   8.660000
  O   7.500000   7.500000   6.340000

K_POINTS gamma
